{
  "name": "build-in-saratov",
  "description": "Personal webdev-related blog of freelance developer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "author": "Sergey Monin <moninsergei@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc -p tsconfig.json && tsc -p infra/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --write \"{app,infra,plugins,server}/**/*.{ts,tsx,css}\"",
    "cdk": "cdk",
    "deploy": "npm run build && cdk deploy BuildInSaratovWebsite",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@griffel/react": "^1.7.8",
    "@griffel/sort-css-queries": "^1.0.2",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5.2.2",
    "medium-zoom": "^1.1.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@shikijs/rehype": "^4.5.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-cdk": "2.1144.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "^10.8.1",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-love": "^158.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hast-util-to-string": "^3.0.1",
    "husky": "^9.1.7",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.9",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
